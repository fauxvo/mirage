# Database
DATABASE_URL=./data/mirage.db

# JWT / Auth
JWT_SECRET=                    # JWT signing secret (required in production, falls back to ADMIN_PASSWORD)
ALLOW_REGISTRATION=true        # Set to 'false' to disable public registration

# Admin Seed (creates initial admin account on first startup)
ADMIN_USERNAME=admin           # Initial admin username (default: admin)
ADMIN_EMAIL=                   # Initial admin email (required for seed)
ADMIN_PASSWORD=                # Initial admin password (min 8 chars, required for seed)

# Legacy (still supported as JWT_SECRET fallback)
ADMIN_SESSION_SECRET=          # Optional: falls back to ADMIN_PASSWORD if JWT_SECRET not set

# Cloudflare R2 / S3-Compatible Storage (optional — run scripts/setup-r2.sh for guided setup)
# If not set, textures use base64 in config JSON (no cloud storage needed)
S3_BUCKET=                         # R2 bucket name (e.g., mirage-textures)
S3_REGION=auto                     # Use "auto" for R2, or a region for AWS S3
S3_ENDPOINT=                       # R2: https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=                  # R2 API Token → Access Key ID
S3_SECRET_ACCESS_KEY=              # R2 API Token → Secret Access Key
S3_FORCE_PATH_STYLE=true           # Required for R2/MinIO
S3_PUBLIC_URL=                     # Optional: r2.dev or custom domain URL (bypasses proxy)
