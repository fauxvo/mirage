# Database
DATABASE_URL=./data/mirage.db

# API Key (optional - if not set, API is open)
MIRAGE_API_KEY=

# S3 Storage (optional - if not set, textures use base64 in config JSON)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=           # For MinIO/R2: http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true  # Required for MinIO
